# Port server backend
PORT=4000

# Kunci penandatangan JWT. Ganti dengan string acak yang panjang sebelum deploy.
JWT_SECRET=studytrack-secret-key-change-this

# Koneksi PostgreSQL (lokal atau cloud seperti Neon/Supabase/Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studytrack

# OpenAI API Key (atau provider OpenAI-compatible gratis seperti Google Gemini / Groq)
OPENAI_API_KEY=
# Opsional: Base URL untuk provider OpenAI-compatible (mis. Gemini: https://generativelanguage.googleapis.com/v1beta/openai/)
OPENAI_BASE_URL=
# Model AI yang digunakan (default: gpt-4o-mini; untuk Gemini: gemini-2.5-flash)
OPENAI_MODEL=gpt-4o-mini
# Timeout maksimal request OpenAI dalam milidetik (default: 3500)
OPENAI_TIMEOUT_MS=3500

# Opsional: daftar origin yang diizinkan oleh CORS (pisahkan dengan koma). Kosongkan untuk mengizinkan semua origin.
CORS_ORIGIN=
