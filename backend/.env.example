# Port server backend
PORT=4000

# Kunci penandatangan JWT. Ganti dengan string acak yang panjang sebelum deploy.
JWT_SECRET=studytrack-secret-key-change-this

# Koneksi PostgreSQL (lokal atau cloud seperti Neon/Supabase/Railway)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studytrack

# OpenAI API Key untuk fitur AI Complexity Triage (opsional; jika kosong akan fallback ke deadline ASC)
OPENAI_API_KEY=
# Model OpenAI yang digunakan (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Timeout maksimal request OpenAI dalam milidetik (default: 3500)
OPENAI_TIMEOUT_MS=3500
